{
  "name": "@cocartheadless/react-native-sdk",
  "version": "1.0.0",
  "description": "Official CoCart SDK for React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "cocart",
    "woocommerce",
    "cart",
    "headless",
    "sdk",
    "react-native",
    "typescript"
  ],
  "author": "CoCart Headless, LLC",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "@cocartheadless/sdk": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "react-native-mmkv": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cocartheadless/sdk": "^1.2.0",
    "@testing-library/react-native": "^13.0.0",
    "react-test-renderer": "18.2.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.0",
    "jest": "^29.0.0",
    "react": "18.2.0",
    "react-native": "^0.74.0",
    "react-native-builder-bob": "^0.30.0",
    "react-native-mmkv": "^3.0.0",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "jest": {
    "preset": "react-native",
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@testing-library)/)"
    ],
    "moduleNameMapper": {
      "react-native-mmkv": "<rootDir>/__mocks__/react-native-mmkv.ts",
      "@react-native-async-storage/async-storage": "<rootDir>/__mocks__/@react-native-async-storage/async-storage.ts"
    }
  }
}
